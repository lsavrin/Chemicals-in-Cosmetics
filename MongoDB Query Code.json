
--Query 1: Chemical Count
[
  {
    $group: {
      _id: "$ChemicalName",
      total_count: {
        $sum: 1
      }
    }
  },
  {
    $sort: {
      total_count: -1
    }
  }
]

--Query 2: Embedded (transactions in store type) Average Spend by Store Type

[
  {
    $unwind: {
      path: "$Transactions"
    }
  },
  {
    $project: {
      Store: 1,
      Type: 1,
      "Transactions.Total": 1
    }
  },
  {
    $group: {
      _id: "$Type",
      Average: {
        $avg: "$Transactions.Total"
      }
    }
  },
  {
    $sort:
      {
        Average: -1
      }
  }
]

--Query 2: Document Based Average Spend by Store Type
[
  {
    $group: {
      _id: "$Transaction ID",
      spend: {
        $first: "$Transaction Total"
      },
      Type: {
        $first: "$Store Type"
      }
    }
  },
  {
    $group: {
      _id: "$Type",
      average: {
        $avg: "$spend"
      }
    }
  },
  {
    $sort: {
      average: -1
    }
  }
]

--Query 3: Embedded (transactions in category) Average by Category
[
  {
    $unwind: {
      path: "$Transactions"
    }
  },
  {
    $unwind: {
      path: "$Transactions.LineItems"
    }
  },
  {
    $group: {
      _id: "$Category",
      average: {
        $avg: "$Transactions.LineItems.TotalUnit"
      }
    }
  },
  {
    $sort:
      {
        average: -1
      }
  }
]


--Query 3: Document Based Average by Category
[
  {
    $group: {
      _id: "$PrimaryCategory",
      avg: {
        $avg: "$LineItemTotal"
      }
    }
  },
  {
    $sort:
      {
        avg: -1
      }
  }
]
